__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.coverage
htmlcov/

.venv/
venv/
env/

build/
dist/
*.egg-info/

.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地运行配置可能包含 API Key，禁止提交真实 TOML 配置。
/config/*.toml

# `*.toml.example` 不匹配上一条规则，因此脱敏示例仍可提交。

# 常见环境变量密钥文件同样禁止提交。
.env
.env.*
!.env.example

# Retry Journal、Checkpoint、SQLite/WAL 等本地运行状态禁止提交。
/state/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
**/.agent-journal.key
